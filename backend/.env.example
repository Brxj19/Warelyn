# Development example only. Production must override database credentials,
# CORS origins, debug mode, JWT secret, and super admin bootstrap values.
WARELYN_APP_NAME="Warelyn Inventory API"
WARELYN_APP_VERSION="0.1.0"
WARELYN_ENVIRONMENT="development"
WARELYN_DEBUG=true
WARELYN_API_PREFIX="/api"
WARELYN_DATABASE_URL="mysql+pymysql://warelyn:warelyn_dev_password@localhost:3306/warelyn_inventory"
WARELYN_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'
WARELYN_JWT_SECRET_KEY="replace-with-a-long-random-secret"
WARELYN_JWT_ALGORITHM="HS256"
WARELYN_ACCESS_TOKEN_EXPIRE_MINUTES=30
WARELYN_REFRESH_TOKEN_EXPIRE_DAYS=14
WARELYN_SUPER_ADMIN_EMAIL="admin@warelyn.local"
WARELYN_SUPER_ADMIN_PASSWORD="ChangeMe123!"
WARELYN_SUPER_ADMIN_NAME="Warelyn Super Admin"
WARELYN_SEED_SUPER_ADMIN_ON_STARTUP=false

# SMTP / Email
WARELYN_SMTP_HOST="localhost"
WARELYN_SMTP_PORT=1025
WARELYN_SMTP_USERNAME=""
WARELYN_SMTP_PASSWORD=""
WARELYN_SMTP_FROM_EMAIL="no-reply@warelyn.local"
WARELYN_SMTP_FROM_NAME="Warelyn"
WARELYN_SMTP_USE_TLS=false
WARELYN_SMTP_USE_SSL=false
WARELYN_EMAIL_DELIVERY_MODE="mailhog"

# OTP
WARELYN_OTP_CODE_LENGTH=6
WARELYN_OTP_EXPIRE_MINUTES=10
WARELYN_OTP_MAX_ATTEMPTS=5
